generator client {
  provider        = "prisma-client"
  output          = "./generated"
  engineType      = "client"
  runtime         = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String
  provider      AuthProvider
  name          String
  supabaseId    String         @unique
  conversations Conversation[]
  memories      Memory[]
  wikiNodes     WikiNode[]
  googleTokens  UserGoogleToken[]
  tasks         Task[]
}

model Conversation {
  id              String    @id @default(uuid())
  title           String?
  slug            String
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  messages        Message[]
  tasks           Task[]
  compaction      String?   @db.Text   // LLM-summarized history when messages exceed budget
  compactMsgCount Int?                 // How many messages were rolled into compaction


  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  role           MessageRole
  conversationId String
  createdAt      DateTime     @default(now())
  sources        Json?        // Array of source objects
  fileAttachment Json?        // For user file attachments
  followUps      Json?        // Array of follow-up questions
  thoughtProcess Json?        // Array of status events (steps) for the thought process
  generatedFiles Json?        // Array of generated document objects (base64, filename, mime, etc.)
  metadata       Json?        // Legacy metadata
  type           String?      // Legacy type
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId])
}

model WikiNode {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  description    String?
  type           String     @default("concept")
  sourceType     String?
  sourceUrl      String?
  metadata       Json?
  x              Float?
  y              Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sourceEdges    WikiEdge[] @relation("EdgeSource")
  targetEdges    WikiEdge[] @relation("EdgeTarget")

  @@unique([userId, label])
  @@index([userId])
}

model WikiEdge {
  id           String   @id @default(uuid())
  sourceId     String
  targetId     String
  relationship String
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())
  source       WikiNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       WikiNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationship])
  @@index([sourceId])
  @@index([targetId])
}

model UserGoogleToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  scope        String
  expiresAt    DateTime?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Memory {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             String                // preference, project, personal, decision, feedback
  fact                 String
  embedding            Unsupported("vector(1024)")
  sourceConversationId String?
  importance           Float                 @default(0.5)
  accessCount          Int                   @default(0)
  lastAccessedAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([userId, category])
}

model DocumentChunk {
  id           String   @id @default(uuid())
  userId       String
  documentName String
  source       String   // "upload" | "read_url"
  sourceUrl    String?
  chunkIndex   Int
  heading      String?
  text         String   @db.Text
  embedding    Unsupported("vector(1024)")
  searchVector Unsupported("tsvector")?
  tokenCount   Int
  contentHash  String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, documentName])
  @@index([contentHash])
}

enum TaskStatus {
  PENDING
  PLANNING
  RUNNING
  WAITING_FOR_INPUT
  PAUSED
  INTERRUPTED
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum StepStatus {
  PENDING
  RUNNING
  BLOCKED
  DONE
  FAILED
  SKIPPED
}

model Task {
  id                String       @id @default(cuid())
  conversationId    String
  userId            String
  sandboxId         String?
  anchorMessageId   Int?         @unique
  status            TaskStatus   @default(PENDING)
  title             String
  goal              String       @db.Text
  planApprovalMode  Boolean      @default(false)
  contextSummary    String?      @db.Text
  costEstimateSecs  Int          @default(0)
  maxDurationSecs   Int          @default(1800)
  maxSteps          Int          @default(20)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  lastHeartbeatAt   DateTime?
  user              User         @relation(fields: [userId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  steps             TaskStep[]

  @@index([status])
  @@index([conversationId])
  @@index([userId, createdAt])
}

model TaskStep {
  id           String     @id @default(cuid())
  taskId       String
  index        Int
  title        String
  status       StepStatus @default(PENDING)
  dependsOn    Int[]      @default([])
  toolCalls    Json?
  result       String?    @db.Text
  filesChanged Json?
  startedAt    DateTime?
  completedAt  DateTime?
  retryCount   Int        @default(0)
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, index])
  @@index([taskId, status])
}

enum MessageRole {
  User
  Assistant
}

enum AuthProvider {
  Github
  Google
}
