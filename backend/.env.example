# Flux backend environment.
# Copy to backend/.env and fill in. Values marked REQUIRED stop the server at boot.

# ---- runtime ----
NODE_ENV=development
PORT=3001
# Comma-separated. Used for CORS and for the frontend origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- database - REQUIRED ----
# PostgreSQL 14+ with the pgvector extension enabled.
# Local: postgresql://postgres:postgres@localhost:5432/flux
DATABASE_URL=

# ---- Supabase auth - REQUIRED ----
# Project URL and service role secret. The service role bypasses RLS; never ship it to the browser.
SUPABASE_URL=
SUPABASE_API_SECRET=

# ---- models - REQUIRED ----
# NVIDIA NIM key. https://build.nvidia.com
NIM_API_KEY=
# Optional overrides.
NIM_TEAM_MODEL=
PLANNER_MODEL=
SUBAGENT_MODEL=
# Comma-separated bearer keys accepted by the OpenAI-compatible endpoint (/v1/chat/completions).
OPENCODE_API_KEYS=

# ---- tools - REQUIRED (search) ----
# Tavily web search. https://tavily.com
TAVILY_API_KEY=

# ---- tools - optional ----
# Sandbox (agent-infra/sandbox). All-in-one container providing shell, file,
# browser, MCP and VSCode. Run it with Docker:
#   docker run -p 127.0.0.1:8080:8080 ghcr.io/agent-infra/sandbox:latest
# Defaults to http://localhost:8080 when unset.
SANDBOX_BASE_URL=
# HuggingFace fallback for model calls.
HF_API_KEY=
# Weather. Open-Meteo is used as a fallback when this is absent.
OPENWEATHER_API_KEY=
# Local image generation service (defaults to http://127.0.0.1:8001).
IMAGE_SERVICE_URL=

# ---- Google integrations - optional ----
# Gmail / Calendar / Drive tools. Create an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
GOOGLE_SCOPES=

# ---- operations - optional ----
# When set, /health requires ?secret=<value>. Leave empty to leave /health open.
HEALTH_SECRET=

# ---- frontend (consumed at build time by Bun, not by the backend) ----
BUN_PUBLIC_BACKEND_URL=http://localhost:3001
BUN_PUBLIC_SUPABASE_URL=
BUN_PUBLIC_SUPABASE_ANON_KEY=
